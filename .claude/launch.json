{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "nota-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 4173,
      "autoPort": true
    },
    {
      "name": "nota-api-demo",
      "runtimeExecutable": "env",
      "runtimeArgs": ["NOTA_DEMO_OPEN=true", "node", "apps/api/local-server.js"],
      "port": 8788,
      "autoPort": true
    },
    {
      "name": "nota-web-demo",
      "runtimeExecutable": "env",
      "runtimeArgs": ["NOTA_API_BASE=http://localhost:8788", "node", "apps/web/run-local.mjs"],
      "port": 4175,
      "autoPort": true
    },
    {
      "name": "nota-admin-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "admin:local"],
      "port": 8790
    },
    {
      "name": "nota-admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:admin"],
      "port": 4174
    }
  ]
}
