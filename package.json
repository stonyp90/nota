{
  "name": "nota",
  "version": "0.1.0",
  "private": true,
  "description": "Nota — a public marketplace where clients in Quebec City post the date they need a notarial act signed and what they will pay for it.",
  "license": "UNLICENSED",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm test --workspace @nota/domain && npm test --workspace @nota/api",
    "test:domain": "npm test --workspace @nota/domain",
    "test:api": "npm test --workspace @nota/api",
    "test:contract": "node --test apps/api/test/contract/*.test.mjs",
    "test:web": "npm test --workspace @nota/web",
    "test:admin": "npm test --workspace @nota/admin",
    "build": "npm run build --workspace @nota/web",
    "build:admin": "npm run build --workspace @nota/admin",
    "dev": "npm run dev --workspace @nota/web",
    "dev:admin": "npm run dev --workspace @nota/admin",
    "api:local": "npm run start --workspace @nota/api",
    "admin:local": "npm run start:admin --workspace @nota/api",
    "local": "node apps/api/scripts/dev-all.js",
    "local:tables": "node apps/api/scripts/create-table.js",
    "local:seed": "node apps/api/scripts/seed.js",
    "local:check": "node apps/api/scripts/check-stack.js",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
