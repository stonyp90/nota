# Dependencies
node_modules/
**/node_modules/

# Build output
apps/web/dist/
apps/admin/dist/
apps/api/build/
infra/build/

# Playwright E2E artifacts
test-results/
# La vidéo de démonstration est PRODUITE par `npm run demo:salle`, jamais
# versionnée : c'est un artefact, et il pèse des dizaines de mégaoctets.
demo/sortie/
playwright-report/
/blob-report/
.playwright/

# Terraform
infra/.terraform/
infra/.terraform.lock.hcl
*.tfstate
*.tfstate.*
infra/terraform.tfvars
crash.log

# Secrets / local env — never commit credentials
.env
.env.*
*.pem
awsenv.sh

# Claude Code runtime state (the launch config itself IS committed)
.claude/scheduled_tasks.lock

# OS / editor
.DS_Store
*.log
.idea/
.vscode/

# Courriels capturés par la pile locale (createFileMailer) — jamais versionnés.
.local-mail/

# Environment-specific Terraform inputs (examples stay versioned).
infra/*.tfvars
!infra/*.tfvars.example

# Rendus vidéo et artefacts QA produits localement (418 Mo) — jamais versionnés.
output/

# Python bytecode des scripts d'exploitation.
__pycache__/
*.pyc

# Scratch build output and unrelated temp files (never versioned).
.codex-build/
tmp/
